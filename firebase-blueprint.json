{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Apparel and garment items for sale.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "priceRange": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "model3dUrl": { "type": "string", "format": "uri" },
        "linkUrl": { "type": "string", "format": "uri" },
        "category": { "type": "string" },
        "colors": { "type": "array", "items": { "type": "string" } },
        "variants": { "type": "array", "items": { "type": "object" } },
        "subItems": { "type": "array", "items": { "type": "string" } },
        "brand": { "type": "string" },
        "sku": { "type": "string" },
        "gtin": { "type": "string" },
        "mpn": { "type": "string" },
        "condition": { "type": "string", "enum": ["new", "refurbished", "used"] },
        "availability": { "type": "string", "enum": ["in_stock", "out_of_stock", "preorder", "backorder"] },
        "googleProductCategory": { "type": "string" },
        "isDeleted": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "imageUrl", "category"]
    },
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global configuration for brand assets and integrations.",
      "type": "object",
      "properties": {
        "headerLogoUrl": { "type": "string", "format": "uri" },
        "faviconUrl": { "type": "string", "format": "uri" },
        "footerLogoUrl": { "type": "string", "format": "uri" },
        "analyticsId": { "type": "string" },
        "brandColors": {
          "type": "object",
          "properties": {
            "primary": { "type": "string" },
            "secondary": { "type": "string" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Client orders for garments.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "customerEmail", "items", "totalAmount"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System alerts and order updates.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["order", "system", "alert"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "InboundMail": {
      "title": "Inbound Mail",
      "description": "Messages from contact forms or synchronized gmail inquiries.",
      "type": "object",
      "properties": {
        "subject": { "type": "string" },
        "from": { "type": "string" },
        "fromEmail": { "type": "string", "format": "email" },
        "body": { "type": "string" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "isStarred": { "type": "boolean" }
      }
    },
    "Slider": {
      "title": "Slider",
      "description": "Hero section slides for the main carousel.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "buttonText": { "type": "string" },
        "buttonLink": { "type": "string" },
        "badge": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "imageUrl", "order"]
    },
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "Stunning visuals for the mobile gallery showcase.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "category": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "imageUrl"]
    },
    "AdminUser": {
      "title": "Admin User",
      "description": "Authorized staff, editors, and superadministrators for the management portal.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["superadmin", "admin", "editor"] },
        "phone": { "type": "string" },
        "department": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "addedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Category": {
      "title": "Category",
      "description": "Collection and showcase categories with round badges and technical specifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "items": { "type": "array", "items": { "type": "string" } },
        "specialties": { "type": "array", "items": { "type": "string" } },
        "materials": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "image"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "description": "Customer contact tickets, quotation requests, and helpdesk inquiries.",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "customerPhone": { "type": "string" },
        "companyName": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] },
        "source": { "type": "string" },
        "emailDispatched": { "type": "boolean" },
        "assignedTo": { "type": "string" },
        "adminNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketId", "customerName", "message", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of all saleable garments."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of garment categories and showcase circles."
    },
    "/settings/global": {
      "schema": "SiteSettings",
      "description": "Single document for global site configuration."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer order records."
    },
    "/notifications/{notifId}": {
      "schema": "Notification",
      "description": "Real-time alerts for the admin dashboard."
    },
    "/messages/{msgId}": {
      "schema": "InboundMail",
      "description": "Internal communication records."
    },
    "/contact_inquiries/{inquiryId}": {
      "schema": "InboundMail",
      "description": "Public contact form inquiries."
    },
    "/tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Customer helpdesk and quotation tickets raised via website contact or admin."
    },
    "/sliders/{sliderId}": {
      "schema": "Slider",
      "description": "Dynamic slides for the website hero section."
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Showcase items for the portfolio gallery."
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Authorized staff, editors, and superadministrators access directory."
    }
  }
}
