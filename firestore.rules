rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'urbaninteriorkenya@gmail.com' ||
        request.auth.token.email == 'zamodasports@gmail.com' ||
        request.auth.token.email == 'gduniversalstudio@gmail.com'
      );
    }

    // POS Operators Collection
    match /pos_operators/{operatorId} {
      allow read, write: if true;
    }

    // Products Collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Inter-Store Transfers Collection
    match /transfers/{transferId} {
      allow read, write: if true;
    }

    // Accounting Ledger Collection
    match /ledger/{ledgerId} {
      allow read, write: if true;
    }

    // Branch Locations Collection
    match /locations/{locationId} {
      allow read, write: if true;
    }

    // Branch Expenses Collection
    match /branch_expenses/{expenseId} {
      allow read, write: if true;
    }

    // Staff Members Collection
    match /staff_members/{staffId} {
      allow read, write: if true;
    }

    // HR Payroll Records Collection
    match /payroll/{payrollId} {
      allow read, write: if true;
    }

    // Cashier Shift Closures Collection
    match /shift_closures/{shiftId} {
      allow read, write: if true;
    }

    // Fabric Rolls & Piece Goods Inventory
    match /fabric_rolls/{rollId} {
      allow read, write: if true;
    }

    // Fixed Assets Collection
    match /fixed_assets/{assetId} {
      allow read, write: if true;
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // System Settings Collection
    match /system_settings/{settingId} {
      allow read, write: if true;
    }

    // Category Pricing Configurations
    match /category_pricing/{categoryId} {
      allow read, write: if true;
    }

    match /category_pricing_configs/{categoryId} {
      allow read, write: if true;
    }

    // Category Images & Brand Visuals
    match /category_images/{imageId} {
      allow read, write: if true;
    }

    // Category Discounts & Wholesale Rules
    match /category_discounts/{discountId} {
      allow read, write: if true;
    }

    // Brand Identity & Enterprise Terminal Settings
    match /brand_settings/{settingsId} {
      allow read, write: if true;
    }

    // Quarantined Defects
    match /quarantine_defects/{defectId} {
      allow read, write: if true;
    }

    // Credit Notes
    match /credit_notes/{noteId} {
      allow read, write: if true;
    }

    // Suppliers Registry Collection
    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
