rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Public catalog content (Products)
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Hero Carousel Sliders
    match /sliders/{sliderId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Collections, Categories & Round Showcase Circles
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Global Brand & Site Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Visual Showcase Gallery
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Customer Orders & Quotation Inquiries
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Inbound Inquiries & Contact Messages
    match /messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    match /contact_inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Support Tickets & Customer Helpdesk
    match /tickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Notifications for Admin Portal
    match /notifications/{notifId} {
      allow read, write: if isSignedIn();
    }

    // Admin Access Management
    match /admins/{adminId} {
      allow read, write: if isSignedIn();
    }
  }
}

