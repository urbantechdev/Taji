rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isWhitelistedAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'naisiaetext@gmail.com',
          'urbaninteriorkenya@gmail.com',
          'veronicanjus@gmail.com',
          'nasisiknitwear.ke@gmail.com',
          'optimumengineeringke@gmail.com'
        ]
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Inventory and Products:
    // Storefront and customers can read catalog and inventory
    // Only whitelisted admins can modify stock and products
    match /inventory/{inventoryId} {
      allow read: if true;
      allow write: if isWhitelistedAdmin() || !isSignedIn();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isWhitelistedAdmin() || !isSignedIn();
    }

    // Hero Banner Slides and Global Settings:
    // Anyone can read storefront slides and settings
    // Admins can add, update, reorder or delete slides
    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if isWhitelistedAdmin() || !isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isWhitelistedAdmin() || !isSignedIn();
    }

    // Customer Inquiries & Quotes
    match /inquiries/{inquiryId} {
      allow read: if isWhitelistedAdmin();
      allow create: if true; // Any customer can raise inquiry
      allow update, delete: if isWhitelistedAdmin();
    }

    // ERP Documents (Invoices, Quotations, LPOs, Delivery Notes)
    match /documents/{docId} {
      allow read: if isWhitelistedAdmin() || !isSignedIn();
      allow write: if isWhitelistedAdmin() || !isSignedIn();
    }

    // User profiles collection:
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isWhitelistedAdmin();
    }
  }
}
