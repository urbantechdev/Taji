rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'urbaninteriorkenya@gmail.com' ||
        request.auth.token.email == 'zamodasports@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // POS Operators Collection - readable by store cashiers/devices, managed by admin or operators
    match /pos_operators/{operatorId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Products Collection - accessible and editable from anywhere (phone, laptop, tablet)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Category Pricing Configurations
    match /category_pricing/{categoryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /category_pricing_configs/{categoryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Category Images
    match /category_images/{imageId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // System Settings (Stock Alerts, etc.)
    match /system_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Sales Orders Collection
    match /orders/{orderId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Brand Settings Collection
    match /brand_settings/{settingsId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
